{
  "name": "cli-openai-proxy",
  "version": "2.0.0",
  "description": "Run agentic coding CLIs (Claude Code, Codex, Paperclip adapters) behind an OpenAI-compatible API. Use your existing CLI subscription with any OpenAI client.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "cli-openai-proxy": "dist/server/standalone.js"
  },
  "scripts": {
    "postinstall": "node scripts/fix-node-pty-permissions.mjs",
    "build": "npm run clean && tsc",
    "lint": "tsc --noEmit",
    "dev": "tsc --watch",
    "start": "node dist/server/standalone.js",
    "test": "find dist -name '*.test.js' -print0 | xargs -0 node --test",
    "test:coverage": "c8 --exclude-after-remap --all --src=src --include='**/*.ts' --exclude='**/*.test.ts' --reporter=text --reporter=lcov --check-coverage --statements=80 --branches=80 --functions=85 --lines=80 node --test $(find dist -name '*.test.js' -print)",
    "clean": "node tools/clean.mjs",
    "prepublishOnly": "npm run build && node tools/check-package-contents.mjs"
  },
  "keywords": [
    "claude",
    "anthropic",
    "claude-code",
    "claude-max",
    "codex",
    "cli-proxy",
    "openai-compatible",
    "api-server",
    "oauth",
    "clawdbot",
    "llm",
    "ai"
  ],
  "author": "Soonoh Jung",
  "contributors": [
    "Atal Ashutosh (https://github.com/atalovesyou)"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sh1nj1/cli-openai-proxy"
  },
  "bugs": {
    "url": "https://github.com/sh1nj1/cli-openai-proxy/issues"
  },
  "homepage": "https://github.com/sh1nj1/cli-openai-proxy#readme",
  "dependencies": {
    "@paperclipai/adapter-claude-local": "2026.722.0",
    "@paperclipai/adapter-codex-local": "2026.722.0",
    "@paperclipai/adapter-utils": "2026.722.0",
    "express": "^4.21.2",
    "node-pty": "^1.1.0",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.7",
    "@types/uuid": "^10.0.0",
    "c8": "^12.0.0",
    "typescript": "^5.7.3"
  },
  "peerDependencies": {
    "clawdbot": ">=2026.1.0"
  },
  "peerDependenciesMeta": {
    "clawdbot": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "files": [
    "dist",
    "scripts",
    "docs",
    "!docs/superpowers",
    "tools/auth-test.html",
    "README.md",
    "CONTRIBUTING.md"
  ]
}
